<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons. The system recolours it, so it must be
  a single flat colour and must read well as a silhouette: the plate is dropped and only
  the mark remains, thickened slightly to survive at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M38,42 H66"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58,42 V68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M38,42 V54 C38,64 45,70 54,70 C61,70 66,65 66,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
