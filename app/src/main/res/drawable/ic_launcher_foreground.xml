<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a key cap with an abstract letterform mark.
  108dp viewport; all art stays inside the 72dp safe zone (26..82) so launcher
  masks (circle, squircle, rounded square) cannot clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Key cap plate -->
    <path
        android:fillColor="#FFFFFF1F"
        android:pathData="M44,26 H64 A18,18 0 0 1 82,44 V64 A18,18 0 0 1 64,82 H44 A18,18 0 0 1 26,64 V44 A18,18 0 0 1 44,26 Z" />

    <!-- Mark: top bar, right stem, left bowl -->
    <path
        android:pathData="M40,44 H64"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58,44 V66"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M40,44 V54 C40,63 46,68 54,68 C60,68 64,64 64,58"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Accent dot -->
    <group android:translateX="72" android:translateY="70">
        <path
            android:fillColor="#6366F1"
            android:pathData="M0,-4 A4,4 0 1 1 0,4 A4,4 0 1 1 0,-4 Z" />
    </group>
</vector>
